{
  "name": "edplan-sync-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MV3 Chrome extension for Streamline to EdPlan sync automation",
  "scripts": {
    "clean": "rm -rf dist build coverage",
    "build": "node scripts/build.mjs",
    "build:dev": "node scripts/build.mjs --dev",
    "package": "node scripts/package.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint \"src/**/*.ts\"",
    "check": "npm run lint && npm run test && npm run build"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.34",
    "@types/node": "^24.5.2",
    "@typescript-eslint/eslint-plugin": "^8.43.0",
    "@typescript-eslint/parser": "^8.43.0",
    "esbuild": "^0.25.10",
    "eslint": "^9.35.0",
    "jsdom": "^27.0.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "zod": "^4.1.11"
  }
}
